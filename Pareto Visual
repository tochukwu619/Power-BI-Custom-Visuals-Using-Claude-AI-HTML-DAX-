Sub Reason Top 6 2 = 
VAR SelectedParam = SELECTEDVALUE('KPI'[KPI Order], 0)
VAR _Total = SWITCH(SelectedParam, 0, [Total Claims], [Total Cost AUD])

VAR _AllReasons = 
    ADDCOLUMNS(
        VALUES('Water Damage Claims'[CLAIM_CAUSE_SUB_REASON]),
        "@Val", CALCULATE(SWITCH(SelectedParam, 0, [Total Claims], [Total Cost AUD]))
    )

VAR _Ranked = TOPN(6, _AllReasons, [@Val], DESC)

VAR _T1Name = MAXX(TOPN(1, _Ranked, [@Val], DESC), 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON])
VAR _T1V    = MAXX(TOPN(1, _Ranked, [@Val], DESC), [@Val])

VAR _T2Name = MAXX(TOPN(1, FILTER(_Ranked, 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T1Name), [@Val], DESC), 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON])
VAR _T2V    = MAXX(FILTER(_Ranked, 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T1Name), [@Val])

VAR _T3Name = MAXX(TOPN(1, FILTER(_Ranked, 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T1Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T2Name), [@Val], DESC), 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON])
VAR _T3V    = MAXX(FILTER(_Ranked, 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T1Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T2Name), [@Val])

VAR _T4Name = MAXX(TOPN(1, FILTER(_Ranked, 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T1Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T2Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T3Name), [@Val], DESC), 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON])
VAR _T4V    = MAXX(FILTER(_Ranked, 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T1Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T2Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T3Name), [@Val])

VAR _T5Name = MAXX(TOPN(1, FILTER(_Ranked, 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T1Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T2Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T3Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T4Name), [@Val], DESC), 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON])
VAR _T5V    = MAXX(FILTER(_Ranked, 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T1Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T2Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T3Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T4Name), [@Val])

VAR _T6Name = MAXX(TOPN(1, FILTER(_Ranked, 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T1Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T2Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T3Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T4Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T5Name), [@Val], DESC), 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON])
VAR _T6V    = MAXX(FILTER(_Ranked, 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T1Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T2Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T3Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T4Name && 'Water Damage Claims'[CLAIM_CAUSE_SUB_REASON] <> _T5Name), [@Val])

VAR _Max = _T1V

VAR _H1 = ROUND(DIVIDE(_T1V, _Max) * 140, 0)
VAR _H2 = ROUND(DIVIDE(_T2V, _Max) * 140, 0)
VAR _H3 = ROUND(DIVIDE(_T3V, _Max) * 140, 0)
VAR _H4 = ROUND(DIVIDE(_T4V, _Max) * 140, 0)
VAR _H5 = ROUND(DIVIDE(_T5V, _Max) * 140, 0)
VAR _H6 = ROUND(DIVIDE(_T6V, _Max) * 140, 0)

VAR _Y1 = 180 - _H1
VAR _Y2 = 180 - _H2
VAR _Y3 = 180 - _H3
VAR _Y4 = 180 - _H4
VAR _Y5 = 180 - _H5
VAR _Y6 = 180 - _H6

VAR _C1 = DIVIDE(_T1V, _Total) * 100
VAR _C2 = _C1 + DIVIDE(_T2V, _Total) * 100
VAR _C3 = _C2 + DIVIDE(_T3V, _Total) * 100
VAR _C4 = _C3 + DIVIDE(_T4V, _Total) * 100
VAR _C5 = _C4 + DIVIDE(_T5V, _Total) * 100
VAR _C6 = _C5 + DIVIDE(_T6V, _Total) * 100

VAR _CY1 = 180 - ROUND(_C1 / 100 * 140, 0)
VAR _CY2 = 180 - ROUND(_C2 / 100 * 140, 0)
VAR _CY3 = 180 - ROUND(_C3 / 100 * 140, 0)
VAR _CY4 = 180 - ROUND(_C4 / 100 * 140, 0)
VAR _CY5 = 180 - ROUND(_C5 / 100 * 140, 0)
VAR _CY6 = 180 - ROUND(_C6 / 100 * 140, 0)

VAR _Y80 = 180 - ROUND(80 / 100 * 140, 0)

VAR _CrossIdx = 
    SWITCH(TRUE(),
        _C1 >= 80, 1,
        _C2 >= 80, 2,
        _C3 >= 80, 3,
        _C4 >= 80, 4,
        _C5 >= 80, 5,
        _C6 >= 80, 6,
        0)
VAR _CrossLabel = 
    IF(_CrossIdx > 0,
        "First " & _CrossIdx & " sub-causes cross the 80% concentration line",
        "Top 6 do not reach 80% — risk is diffuse across many causes")

VAR _MetricLabel = IF(SelectedParam = 0, "claims", "AUD")
VAR _T1Fmt = IF(SelectedParam = 0, FORMAT(_T1V,"#,0"), FORMAT(_T1V/1000000,"#,0.1") & "M")
VAR _T2Fmt = IF(SelectedParam = 0, FORMAT(_T2V,"#,0"), FORMAT(_T2V/1000000,"#,0.1") & "M")
VAR _T3Fmt = IF(SelectedParam = 0, FORMAT(_T3V,"#,0"), FORMAT(_T3V/1000000,"#,0.1") & "M")
VAR _T4Fmt = IF(SelectedParam = 0, FORMAT(_T4V,"#,0"), FORMAT(_T4V/1000000,"#,0.1") & "M")
VAR _T5Fmt = IF(SelectedParam = 0, FORMAT(_T5V,"#,0"), FORMAT(_T5V/1000000,"#,0.1") & "M")
VAR _T6Fmt = IF(SelectedParam = 0, FORMAT(_T6V,"#,0"), FORMAT(_T6V/1000000,"#,0.1") & "M")

VAR _Top6Pct = FORMAT(ROUND(_C6, 1), "0.0") & "%"

VAR _Trunc1 = IF(LEN(_T1Name) > 14, LEFT(_T1Name, 12) & "…", _T1Name)
VAR _Trunc2 = IF(LEN(_T2Name) > 14, LEFT(_T2Name, 12) & "…", _T2Name)
VAR _Trunc3 = IF(LEN(_T3Name) > 14, LEFT(_T3Name, 12) & "…", _T3Name)
VAR _Trunc4 = IF(LEN(_T4Name) > 14, LEFT(_T4Name, 12) & "…", _T4Name)
VAR _Trunc5 = IF(LEN(_T5Name) > 14, LEFT(_T5Name, 12) & "…", _T5Name)
VAR _Trunc6 = IF(LEN(_T6Name) > 14, LEFT(_T6Name, 12) & "…", _T6Name)

RETURN
