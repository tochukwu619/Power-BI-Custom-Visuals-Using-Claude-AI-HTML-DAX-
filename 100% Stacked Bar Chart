Age Band Strip Data Full = 
VAR SelectedParam = SELECTEDVALUE('Parameter 2'[Parameter Order], 0)

VAR Pre1960 = CALCULATE(
    SWITCH(SelectedParam, 0, [Total Claims], [Total Cost AUD]),
    'Water Damage Claims'[PROPERTY_AGE_BAND] = "Pre-1960")
VAR Band6090 = CALCULATE(
    SWITCH(SelectedParam, 0, [Total Claims], [Total Cost AUD]),
    'Water Damage Claims'[PROPERTY_AGE_BAND] = "1960-1990")
VAR Band9015 = CALCULATE(
    SWITCH(SelectedParam, 0, [Total Claims], [Total Cost AUD]),
    'Water Damage Claims'[PROPERTY_AGE_BAND] = "1990-2015")
VAR Modern = CALCULATE(
    SWITCH(SelectedParam, 0, [Total Claims], [Total Cost AUD]),
    'Water Damage Claims'[PROPERTY_AGE_BAND] = "2015+")

VAR Total = Pre1960 + Band6090 + Band9015 + Modern

VAR P1 = FORMAT(DIVIDE(Pre1960, Total) * 100, "0") & "%"
VAR P2 = FORMAT(DIVIDE(Band6090, Total) * 100, "0") & "%"
VAR P3 = FORMAT(DIVIDE(Band9015, Total) * 100, "0") & "%"
VAR P4 = FORMAT(DIVIDE(Modern,  Total) * 100, "0") & "%"

VAR N1 = IF(SelectedParam = 0, FORMAT(Pre1960, "#,0"), FORMAT(Pre1960/1000000, "#,0.0") & "M")
VAR N2 = IF(SelectedParam = 0, FORMAT(Band6090, "#,0"), FORMAT(Band6090/1000000, "#,0.0") & "M")
VAR N3 = IF(SelectedParam = 0, FORMAT(Band9015, "#,0"), FORMAT(Band9015/1000000, "#,0.0") & "M")
VAR N4 = IF(SelectedParam = 0, FORMAT(Modern, "#,0"), FORMAT(Modern/1000000, "#,0.0") & "M")

VAR TimesLess = FORMAT(ROUND(DIVIDE(Pre1960, Modern), 0), "0")
VAR MetricLabel = IF(SelectedParam = 0, "claims", "cost AUD")
VAR InsightText = "Modern builds (2015+) show " & TimesLess & "x less " & MetricLabel & " than Pre-1960 stock"

VAR SmallLabel = IF(SelectedParam = 0,
    "2015+ modern builds account for only " & P4 & " of total claims (" & N4 & ") — the lowest risk age band in the portfolio.",
    "2015+ modern builds account for only " & P4 & " of total cost AUD (" & N4 & ") — significantly lower exposure vs older stock."
)

VAR ModernWidth = DIVIDE(Modern, Total) * 1000

VAR X1S = "0"
VAR X2S = FORMAT(DIVIDE(Pre1960,Total)*1000 + 2, "0")
VAR X3S = FORMAT((DIVIDE(Pre1960,Total)+DIVIDE(Band6090,Total))*1000 + 4, "0")
VAR X4S = FORMAT((DIVIDE(Pre1960,Total)+DIVIDE(Band6090,Total)+DIVIDE(Band9015,Total))*1000 + 6, "0")

VAR W1S = FORMAT(DIVIDE(Pre1960,Total)*1000, "0")
VAR W2S = FORMAT(DIVIDE(Band6090,Total)*1000, "0")
VAR W3S = FORMAT(DIVIDE(Band9015,Total)*1000, "0")
VAR W4S = FORMAT(ModernWidth, "0")

VAR MX1 = FORMAT(DIVIDE(Pre1960,Total)*500, "0")
VAR MX2 = FORMAT(DIVIDE(Pre1960,Total)*1000 + DIVIDE(Band6090,Total)*500, "0")
VAR MX3 = FORMAT((DIVIDE(Pre1960,Total)+DIVIDE(Band6090,Total))*1000 + DIVIDE(Band9015,Total)*500, "0")
VAR MX4 = FORMAT((DIVIDE(Pre1960,Total)+DIVIDE(Band6090,Total)+DIVIDE(Band9015,Total))*1000 + ModernWidth/2 + 6, "0")
VAR MX4out = FORMAT((DIVIDE(Pre1960,Total)+DIVIDE(Band6090,Total)+DIVIDE(Band9015,Total))*1000 + ModernWidth + 20, "0")

RETURN
"<div style='font-family:Inter,sans-serif;background:transparent;padding:8px 16px'>" &

"<svg width='100%' height='48' viewBox='0 0 1000 48' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg' style='display:block;margin-bottom:8px;border-radius:6px'>" &

"<rect x='" & X1S & "' y='0' width='" & W1S & "' height='48' fill='rgb(45,27,78)'/>" &
"<rect x='" & X2S & "' y='0' width='" & W2S & "' height='48' fill='rgb(192,132,252)'/>" &
"<rect x='" & X3S & "' y='0' width='" & W3S & "' height='48' fill='rgb(221,214,243)'/>" &
"<rect x='" & X4S & "' y='0' width='" & W4S & "' height='48' fill='rgb(52,211,153)'/>" &

"<text x='" & MX1 & "' y='22' text-anchor='middle' font-size='16' font-weight='700' fill='white' font-family='Inter,sans-serif'>" & P1 & "</text>" &
"<text x='" & MX1 & "' y='38' text-anchor='middle' font-size='11' fill='rgba(255,255,255,0.7)' font-family='Inter,sans-serif'>" & N1 & "</text>" &

"<text x='" & MX2 & "' y='22' text-anchor='middle' font-size='16' font-weight='700' fill='white' font-family='Inter,sans-serif'>" & P2 & "</text>" &
"<text x='" & MX2 & "' y='38' text-anchor='middle' font-size='11' fill='rgba(255,255,255,0.7)' font-family='Inter,sans-serif'>" & N2 & "</text>" &

"<text x='" & MX3 & "' y='22' text-anchor='middle' font-size='16' font-weight='700' fill='rgb(109,76,158)' font-family='Inter,sans-serif'>" & P3 & "</text>" &
"<text x='" & MX3 & "' y='38' text-anchor='middle' font-size='11' fill='rgba(109,76,158,0.7)' font-family='Inter,sans-serif'>" & N3 & "</text>" &

IF(ModernWidth >= 60,
    "<text x='" & MX4 & "' y='22' text-anchor='middle' font-size='16' font-weight='700' fill='white' font-family='Inter,sans-serif'>" & P4 & "</text>" &
    "<text x='" & MX4 & "' y='38' text-anchor='middle' font-size='11' fill='rgba(255,255,255,0.7)' font-family='Inter,sans-serif'>" & N4 & "</text>",
    "<text x='" & MX4out & "' y='30' text-anchor='start' font-size='11' font-weight='700' fill='rgb(45,27,78)' font-family='Inter,sans-serif'>" & P4 & " · " & N4 & "</text>"
) &

"</svg>" &

"<div style='display:flex;align-items:center;gap:16px;flex-wrap:wrap'>" &

  "<div style='display:flex;align-items:center;gap:6px'>" &
    "<svg width='12' height='12' viewBox='0 0 12 12' xmlns='http://www.w3.org/2000/svg'><rect width='12' height='12' rx='2' fill='rgb(45,27,78)'/></svg>" &
    "<svg width='14' height='14' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg' fill='none' stroke='rgb(45,27,78)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>" &
    "<span style='font-size:11px;font-weight:500;color:rgb(45,27,78)'>Pre-1960 age buildings</span>" &
  "</div>" &

  "<div style='display:flex;align-items:center;gap:6px'>" &
    "<svg width='12' height='12' viewBox='0 0 12 12' xmlns='http://www.w3.org/2000/svg'><rect width='12' height='12' rx='2' fill='rgb(192,132,252)'/></svg>" &
    "<svg width='14' height='14' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg' fill='none' stroke='rgb(192,132,252)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>" &
    "<span style='font-size:11px;font-weight:500;color:rgb(45,27,78)'>1960–1990 age buildings</span>" &
  "</div>" &

  "<div style='display:flex;align-items:center;gap:6px'>" &
    "<svg width='12' height='12' viewBox='0 0 12 12' xmlns='http://www.w3.org/2000/svg'><rect width='12' height='12' rx='2' fill='rgb(221,214,243)'/></svg>" &
    "<svg width='14' height='14' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg' fill='none' stroke='rgb(221,214,243)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>" &
    "<span style='font-size:11px;font-weight:500;color:rgb(45,27,78)'>1990–2015 age buildings</span>" &
  "</div>" &

  "<div style='display:flex;align-items:center;gap:6px'>" &
    "<svg width='12' height='12' viewBox='0 0 12 12' xmlns='http://www.w3.org/2000/svg'><rect width='12' height='12' rx='2' fill='rgb(52,211,153)'/></svg>" &
    "<svg width='14' height='14' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg' fill='none' stroke='rgb(52,211,153)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>" &
    "<span style='font-size:11px;font-weight:500;color:rgb(45,27,78)'>2015+ age buildings</span>" &
  "</div>" &

  "<div style='margin-left:auto;font-size:10px;color:rgb(158,142,192);font-style:italic'>" & InsightText & "</div>" &

"</div>" &

"<div style='margin-top:8px;padding:6px 10px;border-left:3px solid rgb(52,211,153);background:rgb(240,253,244);border-radius:0 4px 4px 0'>" &
  "<span style='font-size:10px;color:rgb(45,27,78);line-height:1.5'>" & SmallLabel & "</span>" &
"</div>" &

"</div>"
